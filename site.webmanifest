{
  "name": "Dodle Search",
  "short_name": "Dodle",
  "description": "A simple search page for a less distracting web.",
  "start_url": "/index.html",
  "scope": "/",
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#202124",
  "background_color": "#202124",
  "display": "standalone"
}